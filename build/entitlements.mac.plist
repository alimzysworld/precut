<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SIGN2: hardened runtime entitlements for the Developer ID build (scripts/release-mac.sh).
     Used for the app, every Electron helper and every bundled tool (electron-builder entitlements and
     entitlementsInherit both point here). Each one is here for a reason:
     - allow-jit: V8 compiles JavaScript to machine code in MAP_JIT memory, in main and in every renderer.
       Without it Electron crashes at launch under the hardened runtime.
     - device.audio-input: voiceover recording. precut asks for the microphone (systemPreferences) and the
       bundled ffmpeg records it through avfoundation; the hardened runtime blocks the microphone without it.
     - automation.apple-events: signing in to an engine opens Terminal through osascript ("tell application
       Terminal"); the hardened runtime refuses Apple Events from precut's process tree without it.
     Not here, on purpose: allow-unsigned-executable-memory (Electron 35 runs with allow-jit alone; the release
     check launches, plays and exports without it) and disable-library-validation (every native module,
     node-pty and apple-player.node, is signed by the same team, so library validation passes). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
