{
  "name": "precut",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "npm run fetch-tools && electron-vite build && electron-builder --mac dmg --arm64 --publish never",
    "release:mac": "bash scripts/release-mac.sh",
    "fetch-tools": "bash scripts/fetch-tools.sh",
    "postinstall": "node scripts/prepare-terminal.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "6.8.10",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@blocknote/core": "0.56.0",
    "@blocknote/mantine": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "framer-motion": "^12.23.24",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "description": "Tag a shoot, sync a mic and cut precuts and selects for DaVinci Resolve.",
